<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="horizontal"
    android:padding="8dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_preview_on"
        android:gravity="center"
        android:text="@string/all_on"
        android:textColor="@color/widget_on_accent"
        android:textStyle="bold" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_off"
        android:gravity="center"
        android:text="@string/all_off"
        android:textColor="@color/widget_text"
        android:textStyle="bold" />
</LinearLayout>
